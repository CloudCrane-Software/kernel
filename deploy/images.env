# Deployed image versions — in-repo mirror of the edge stack compose pins
# (platform repo ops/compose/docker-compose.edge.yml is the deploy authority;
# this file exists so tests/test_docs_sync.py can bind AGENTS.md's topology
# line to checkable values — WO-108 F4). Update both in the same PR.
GATEWAY_IMAGE=cloudcrane/gateway:0.1.6
AUDIT_EXPORT_IMAGE=cloudcrane/audit-export:0.2.0
# RunscRunner default image (kernel/runner/runsc.py); the resident build is
# tagged with BOTH kernel-task:latest and cloudcrane/kernel-task:latest —
# see deploy/kernel-task.Dockerfile.
KERNEL_TASK_IMAGE=kernel-task:latest
